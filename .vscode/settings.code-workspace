{
  "extensions": {
    "recommendations": [
      "charliermarsh.ruff",
      "christian-kohler.path-intellisense",
      "esbenp.prettier-vscode",
      "github.github-vscode-theme",
      "grapecity.gc-excelviewer",
      "irongeek.vscode-env",
      "mechatroner.rainbow-csv",
      "ms-azuretools.vscode-containers",
      "ms-dotnettools.vscode-dotnet-runtime",
      "ms-mssql.data-workspace-vscode",
      "ms-mssql.mssql",
      "ms-mssql.sql-bindings-vscode",
      "ms-mssql.sql-database-projects-vscode",
      "ms-python.debugpy",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.vscode-python-envs",
      "ms-toolsai.datawrangler",
      "ms-toolsai.jupyter",
      "ms-toolsai.jupyter-keymap",
      "ms-toolsai.jupyter-renderers",
      "ms-toolsai.vscode-jupyter-cell-tags",
      "ms-toolsai.vscode-jupyter-slideshow",
      "ms-vscode.powershell",
      "pkief.material-icon-theme",
      "richie5um2.vscode-sort-json",
      "tamasfe.even-better-toml",
      "tyriar.sort-lines",
    ],
  },
  "folders": [
    {
      "name": "root",
      "path": "..",
    },
  ],
  "settings": {
    "[css]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.suggest.insertMode": "replace",
    },
    "[html]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.suggest.insertMode": "replace",
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.maxTokenizationLineLength": 2500,
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.maxTokenizationLineLength": 2500,
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.quickSuggestions": {
        "strings": true,
      },
      "editor.suggest.insertMode": "replace",
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.quickSuggestions": {
        "strings": true,
      },
      "editor.suggest.insertMode": "replace",
    },
    "[jsonl]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.quickSuggestions": {
        "strings": true,
      },
      "editor.suggest.insertMode": "replace",
    },
    "[jupyter-notebook]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
    },
    "[markdown]": {
      "diffEditor.ignoreTrimWhitespace": false,
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.quickSuggestions": {
        "comments": "off",
        "other": "off",
        "strings": "off",
      },
      "editor.unicodeHighlight.ambiguousCharacters": false,
      "editor.unicodeHighlight.invisibleCharacters": false,
      "editor.wordWrap": "on",
    },
    "[python]": {
      "diffEditor.ignoreTrimWhitespace": false,
      "editor.defaultColorDecorators": "never",
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnType": true,
      "editor.wordBasedSuggestions": "off",
    },
    "[scss]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.suggest.insertMode": "replace",
    },
    "[sql]": {
      "editor.defaultFormatter": "ms-mssql.mssql",
    },
    "[yaml]": {
      "diffEditor.ignoreTrimWhitespace": false,
      "editor.autoIndent": "advanced",
      "editor.defaultColorDecorators": "never",
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.insertSpaces": true,
      "editor.quickSuggestions": {
        "strings": "on",
      },
      "editor.tabSize": 2,
    },
    "editor.detectIndentation": false,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnType": true,
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "all",
    "editor.rulers": [80],
    "editor.tabSize": 2,
    "explorer.compactFolders": false,
    // "extensions.experimental.affinity": {
    //   "ms-dotnettools.vscode-dotnet-runtime": 1,
    //   "ms-python.debugpy": 1,
    //   "ms-python.python": 1,
    //   "ms-python.vscode-pylance": 1,
    //   "ms-toolsai.datawrangler": 1,
    //   "ms-toolsai.jupyter": 1,
    //   "ms-toolsai.jupyter-renderers": 1,
    // },
    "files.exclude": {
      "**/.DS_Store": true,
      "**/.git": true,
      "**/.hg": true,
      "**/.svn": true,
      "**/.venv": true,
      "**/Thumbs.db": true,
      "**/__pycache__": true,
    },
    "jupyter.askForKernelRestart": false,
    "mssql.connectionGroups": [
      {
        "id": "ROOT",
        "name": "ROOT",
      },
    ],
    "mssql.connections": [
      {
        "applicationName": "SQL Server Management Studio",
        "authenticationType": "Integrated",
        "commandTimeout": 0,
        "connectRetryCount": 1,
        "connectRetryInterval": 10,
        "connectTimeout": 30,
        "encrypt": "Mandatory",
        "groupId": "ROOT",
        "id": "2b14ae03-847d-461d-89aa-9ef296fda4f5",
        "password": "",
        "pooling": false,
        "server": "ZETALAPTOP\\SQLEXPRESS",
        "trustServerCertificate": true,
      },
    ],
    "notebook.breadcrumbs.showCodeCells": false,
    "notebook.cellFocusIndicator": "border",
    "notebook.cellToolbarLocation": {
      "default": "hidden",
    },
    "notebook.cellToolbarVisibility": "hover",
    "notebook.compactView": true,
    "notebook.formatOnCellExecution": true,
    "notebook.formatOnSave.enabled": true,
    "notebook.lineNumbers": "on",
    "notebook.output.scrolling": true,
    "notebook.output.textLineLimit": 30,
    "notebook.showCellStatusBar": "hidden",
    "notebook.showFoldingControls": "always",
    "powershell.cwd": "root",
    "python.analysis.typeCheckingMode": "strict",
    "python.terminal.activateEnvironment": false,
    "terminal.integrated.defaultProfile.windows": "Data Analyst PowerShell",
    "terminal.integrated.profiles.windows": {
      "Data Analyst PowerShell": {
        "args": [
          "-NoExit",
          "-Command",
          "& '${workspaceFolder}\\.venv\\Scripts\\Activate.ps1'; Clear-Host",
        ],
        "source": "PowerShell",
      },
    },
    "workbench.editorAssociations": {
      "*.copilotmd": "vscode.markdown.preview.editor",
      "*.ipynb": "jupyter-notebook",
    },
  },
}
